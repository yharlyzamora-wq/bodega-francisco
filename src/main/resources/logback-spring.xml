<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <property name="PATRON" value="%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
  <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>${PATRON}</pattern></encoder>
  </appender>
  <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>logs/bodega.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>logs/bodega.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>5MB</maxFileSize>
      <maxHistory>14</maxHistory>
    </rollingPolicy>
    <encoder><pattern>${PATRON}</pattern></encoder>
  </appender>
  <!-- Politica: no registrar contrasenas, tokens ni comprobantes completos -->
  <logger name="pe.bodegafrancisco" level="DEBUG"/>
  <root level="INFO">
    <appender-ref ref="CONSOLA"/>
    <appender-ref ref="ARCHIVO"/>
  </root>
</configuration>
